{%- set input_types = ir | go_input_types -%}
{%- set_global uses_fmt = false -%}
{%- for op in operations -%}
{%- if op.params | length > 0 or op.request_body.required -%}
{%- set_global uses_fmt = true -%}
{%- endif -%}
{%- endfor -%}
package {{ package_name }}

import (
{%- if operations | length > 0 %}
	"context"
	"io"
{%- endif %}
{%- if uses_fmt %}
	"fmt"
{%- endif %}
	"net/http"
	"net/url"
	"strings"
)

const SDKVersion = "{{ version }}"

// ErrorHandler converts a non-successful HTTP response into an error.
type ErrorHandler func(*http.Response) error

// ClientOptions configures a Client.
type ClientOptions struct {
	HTTPClient               *http.Client
	Headers                  http.Header
	OnError                  ErrorHandler
	ValidateContentEncodings *bool
}

// RequestOptions configures a single API request.
type RequestOptions struct {
	Headers                  http.Header
	Query                    url.Values
	Cookies                  []*http.Cookie
	OnError                  ErrorHandler
	ValidateContentEncodings *bool
}

// RequestOption configures a single call. Options are applied once, in order.
type RequestOption func(*RequestOptions)

// WithRequestOptions replaces the per-call settings. The last invocation wins.
func WithRequestOptions(options RequestOptions) RequestOption {
    return func(target *RequestOptions) { *target = options }
}

func resolveRequestOptions(options []RequestOption) *RequestOptions {
    if len(options) == 0 { return nil }
    resolved := &RequestOptions{}
    for _, option := range options {
        if option != nil { option(resolved) }
    }
    return resolved
}

// Client is a client for the generated API.
type Client struct {
	baseURL    string
	httpClient *http.Client
	headers    http.Header
	onError    ErrorHandler
	validateContentEncodings bool
{% if config.group_by_tag %}{%- set tag_groups = operations | go_tag_groups %}
{%- for group in tag_groups %}
	{{ group.field_name }} *{{ group.struct_name }}
{%- endfor %}
{% endif %}
}

// NewClient creates a client using baseURL as the API root.
func NewClient(baseURL string, options *ClientOptions) *Client {
	client := &Client{
		baseURL:    strings.TrimRight(baseURL, "/"),
		httpClient: http.DefaultClient,
		headers:    cloneHeaders(nil),
		onError:    defaultOnError,
		validateContentEncodings: true,
	}

	if options != nil {
		if options.HTTPClient != nil {
			client.httpClient = options.HTTPClient
		}
		if options.Headers != nil {
			client.headers = cloneHeaders(options.Headers)
		}
		if options.OnError != nil {
			client.onError = options.OnError
		}
		if options.ValidateContentEncodings != nil {
			client.validateContentEncodings = *options.ValidateContentEncodings
		}
	}

{% if config.group_by_tag %}{%- set tag_groups = operations | go_tag_groups %}
{%- for group in tag_groups %}
	client.{{ group.field_name }} = &{{ group.struct_name }}{client: client}
{%- endfor %}
{% endif %}

	return client
}

{% if config.group_by_tag %}
{%- set tag_groups = operations | go_tag_groups %}
{%- for op in operations %}
{%- set _primary_tag = op | go_primary_tag %}
{%- if not _primary_tag %}
{%- set receiver_name = "c" %}
{%- set receiver_type = "Client" %}
{%- set client_expression = "c" %}
{% include "partials/client_method.go.tera" %}
{% endif %}
{%- endfor %}
{%- for group in tag_groups %}
{%- set service = group %}
{% include "partials/service.go.tera" %}
{% endfor %}
{% else %}
{%- for op in operations %}
{%- set receiver_name = "c" %}
{%- set receiver_type = "Client" %}
{%- set client_expression = "c" %}
{% include "partials/client_method.go.tera" %}
{% endfor %}
{% endif %}
