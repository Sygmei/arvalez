{% endif -%}
{%- endfor -%}
func ({{ receiver_name }} *{{ receiver_type }}) {{ method_name }}({{ op | go_args_sig }}) {{ return_shape.signature }} {
	{{ op.client_identifier }} := {{ client_expression }}
	{{ op.response_identifier }}, {{ op.err_identifier }} := {{ receiver_name }}.{{ raw_method_name }}({{ op | go_forward_args }})
{% if return_shape.has_result %}
	if {{ op.err_identifier }} != nil {
{% if return_shape.returns_nil_on_error %}
		return nil, {{ op.err_identifier }}
{% else %}
		var {{ op.zero_identifier }} {{ return_shape.result_go_type }}
		return {{ op.zero_identifier }}, {{ op.err_identifier }}
{% endif %}
	}
	defer {{ op.response_identifier }}.Body.Close()
	if {{ op.err_identifier }} := {{ op.client_identifier }}.handleError({{ op.response_identifier }}, {{ op.request_options_identifier }}); {{ op.err_identifier }} != nil {
{% if return_shape.returns_nil_on_error %}
		return nil, {{ op.err_identifier }}
{% else %}
		var {{ op.zero_identifier }} {{ return_shape.result_go_type }}
		return {{ op.zero_identifier }}, {{ op.err_identifier }}
{% endif %}
	}
	var {{ op.result_identifier }} {{ return_shape.decode_go_type }}
	if {{ op.err_identifier }} := {{ op.client_identifier }}.decodeJSONResponse({{ op.response_identifier }}, &{{ op.result_identifier }}); {{ op.err_identifier }} != nil {
{% if return_shape.returns_nil_on_error %}
		return nil, {{ op.err_identifier }}
{% else %}
		var {{ op.zero_identifier }} {{ return_shape.result_go_type }}
		return {{ op.zero_identifier }}, {{ op.err_identifier }}
{% endif %}
	}
{% if return_shape.content_encoding %}
	if {{ op.err_identifier }} := {{ op.client_identifier }}.validateStringEncoding({{ op.result_identifier }}, "{{ return_shape.content_encoding }}", "response body", {{ op.request_options_identifier }}); {{ op.err_identifier }} != nil {
{% if return_shape.returns_nil_on_error %}
		return nil, {{ op.err_identifier }}
{% else %}
		var {{ op.zero_identifier }} {{ return_shape.result_go_type }}
		return {{ op.zero_identifier }}, {{ op.err_identifier }}
{% endif %}
	}
{% endif %}
{% if return_shape.returns_pointer %}
	return &{{ op.result_identifier }}, nil
{% else %}
	return {{ op.result_identifier }}, nil
{% endif %}
{% else %}
	if {{ op.err_identifier }} != nil {
		return {{ op.err_identifier }}
	}
	defer {{ op.response_identifier }}.Body.Close()
	if {{ op.err_identifier }} := {{ op.client_identifier }}.handleError({{ op.response_identifier }}, {{ op.request_options_identifier }}); {{ op.err_identifier }} != nil {
		return {{ op.err_identifier }}
	}
	return nil
{% endif %}
}
