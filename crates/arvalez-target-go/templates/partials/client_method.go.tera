{%- set op = op | go_operation -%}
{%- set method_name = op.name | go_exported -%}
{%- set raw_method_name = method_name ~ "Raw" -%}
{%- set return_shape = op | go_return_shape -%}
{%- set path_params = op.params | filter(attribute="location", value="path") -%}
{%- set query_params = op.params | filter(attribute="location", value="query") -%}
{%- set header_params = op.params | filter(attribute="location", value="header") -%}
{%- set cookie_params = op.params | filter(attribute="location", value="cookie") -%}
{%- set body = op | go_body_view -%}
{% if op.attributes.summary -%}
// {{ raw_method_name }} {{ op.attributes.summary | go_comment }}
{% endif -%}
// {{ raw_method_name }} returns the raw HTTP response without decoding it or converting HTTP errors.
{% if op.attributes.deprecated -%}
// Deprecated: This operation is deprecated.
{% endif -%}
{%- for p in op.params %}
{%- if p.attributes.description -%}
// {{ raw_method_name }} parameter {{ p.identifier | default(value=p.name) }}: {{ p.attributes.description | go_comment }}
{% endif -%}
{%- endfor -%}
func ({{ receiver_name }} *{{ receiver_type }}) {{ raw_method_name }}({{ op | go_args_sig }}) (*http.Response, error) {
	{{ op.client_identifier }} := {{ client_expression }}
{% if path_params | length > 0 %}
	{{ op.path_identifier }} := fmt.Sprintf("{{ op.path | go_path_format }}", {% for p in path_params %}url.PathEscape(fmt.Sprint({{ p.identifier | default(value=p.name) }})){% if not loop.last %}, {% endif %}{% endfor %})
{% else %}
	{{ op.path_identifier }} := "{{ op.path }}"
{% endif %}
	{{ op.query_identifier }} := url.Values{}
{% for p in path_params %}{% if p.attributes.content_encoding %}
	if {{ op.err_identifier }} := {{ op.client_identifier }}.validateStringEncoding({{ p.identifier | default(value=p.name) }}, "{{ p.attributes.content_encoding }}", "path parameter `{{ p.name }}`", {{ op.request_options_identifier }}); {{ op.err_identifier }} != nil {
		return nil, {{ op.err_identifier }}
	}
{% endif %}{% endfor %}
{% for p in query_params %}{% if p.required %}{% if p.attributes.content_encoding %}
	if {{ op.err_identifier }} := {{ op.client_identifier }}.validateStringEncoding({{ p.identifier | default(value=p.name) }}, "{{ p.attributes.content_encoding }}", "query parameter `{{ p.name }}`", {{ op.request_options_identifier }}); {{ op.err_identifier }} != nil {
		return nil, {{ op.err_identifier }}
	}
{% endif %}
	{{ op.query_identifier }}.Set("{{ p.name }}", fmt.Sprint({{ p.identifier | default(value=p.name) }}))
{% else %}
	if {{ p.identifier | default(value=p.name) }} != nil {
{%- if p.attributes.content_encoding %}
		if {{ op.err_identifier }} := {{ op.client_identifier }}.validateStringEncoding(*{{ p.identifier | default(value=p.name) }}, "{{ p.attributes.content_encoding }}", "query parameter `{{ p.name }}`", {{ op.request_options_identifier }}); {{ op.err_identifier }} != nil {
			return nil, {{ op.err_identifier }}
		}
{%- endif %}
		{{ op.query_identifier }}.Set("{{ p.name }}", fmt.Sprint(*{{ p.identifier | default(value=p.name) }}))
	}
{% endif %}{% endfor %}
	{{ op.query_identifier }} = {{ op.client_identifier }}.mergeQuery({{ op.query_identifier }}, {{ op.request_options_identifier }})
	{{ op.headers_identifier }} := http.Header{}
{% for p in header_params %}{% if p.required %}{% if p.attributes.content_encoding %}
	if {{ op.err_identifier }} := {{ op.client_identifier }}.validateStringEncoding({{ p.identifier | default(value=p.name) }}, "{{ p.attributes.content_encoding }}", "header `{{ p.name }}`", {{ op.request_options_identifier }}); {{ op.err_identifier }} != nil {
		return nil, {{ op.err_identifier }}
	}
{% endif %}
	{{ op.headers_identifier }}.Set("{{ p.name }}", fmt.Sprint({{ p.identifier | default(value=p.name) }}))
{% else %}
	if {{ p.identifier | default(value=p.name) }} != nil {
{% if p.attributes.content_encoding %}
		if {{ op.err_identifier }} := {{ op.client_identifier }}.validateStringEncoding(*{{ p.identifier | default(value=p.name) }}, "{{ p.attributes.content_encoding }}", "header `{{ p.name }}`", {{ op.request_options_identifier }}); {{ op.err_identifier }} != nil {
			return nil, {{ op.err_identifier }}
		}
{% endif %}
		{{ op.headers_identifier }}.Set("{{ p.name }}", fmt.Sprint(*{{ p.identifier | default(value=p.name) }}))
	}
{% endif %}{% endfor %}
	{{ op.cookies_identifier }} := []*http.Cookie{}
{% for p in cookie_params %}{% if p.required %}{% if p.attributes.content_encoding %}
	if {{ op.err_identifier }} := {{ op.client_identifier }}.validateStringEncoding({{ p.identifier | default(value=p.name) }}, "{{ p.attributes.content_encoding }}", "cookie `{{ p.name }}`", {{ op.request_options_identifier }}); {{ op.err_identifier }} != nil {
			return nil, {{ op.err_identifier }}
	}
{% endif %}
	{{ op.cookies_identifier }} = append({{ op.cookies_identifier }}, &http.Cookie{Name: "{{ p.name }}", Value: fmt.Sprint({{ p.identifier | default(value=p.name) }})})
{% else %}
	if {{ p.identifier | default(value=p.name) }} != nil {
{% if p.attributes.content_encoding %}
		if {{ op.err_identifier }} := {{ op.client_identifier }}.validateStringEncoding(*{{ p.identifier | default(value=p.name) }}, "{{ p.attributes.content_encoding }}", "cookie `{{ p.name }}`", {{ op.request_options_identifier }}); {{ op.err_identifier }} != nil {
			return nil, {{ op.err_identifier }}
		}
{% endif %}
		{{ op.cookies_identifier }} = append({{ op.cookies_identifier }}, &http.Cookie{Name: "{{ p.name }}", Value: fmt.Sprint(*{{ p.identifier | default(value=p.name) }})})
	}
{% endif %}{% endfor %}
	{{ op.cookies_identifier }} = {{ op.client_identifier }}.mergeCookies({{ op.cookies_identifier }}, {{ op.request_options_identifier }})
	var {{ op.body_reader_identifier }} io.Reader
	var {{ op.err_identifier }} error
{% if body %}{% if body.kind == "json" %}
	{{ op.headers_identifier }}.Set("Content-Type", "application/json")
{% if body.required %}{% if body.content_encoding %}
	if {{ op.err_identifier }} := {{ op.client_identifier }}.validateStringEncoding({{ op.body_identifier }}, "{{ body.content_encoding }}", "request body", {{ op.request_options_identifier }}); {{ op.err_identifier }} != nil {
		return nil, {{ op.err_identifier }}
	}
{% endif %}
	{{ op.body_reader_identifier }}, {{ op.err_identifier }} = {{ op.client_identifier }}.encodeJSONBody({{ op.body_identifier }})
	if {{ op.err_identifier }} != nil {
		return nil, {{ op.err_identifier }}
	}
{% else %}
	if {{ op.body_identifier }} != nil {
{% if body.content_encoding %}
		if {{ op.err_identifier }} := {{ op.client_identifier }}.validateStringEncoding({{ op.body_identifier }}, "{{ body.content_encoding }}", "request body", {{ op.request_options_identifier }}); {{ op.err_identifier }} != nil {
			return nil, {{ op.err_identifier }}
		}
{% endif %}
		{{ op.body_reader_identifier }}, {{ op.err_identifier }} = {{ op.client_identifier }}.encodeJSONBody({{ op.body_identifier }})
		if {{ op.err_identifier }} != nil {
			return nil, {{ op.err_identifier }}
		}
	}
{% endif %}{% elif body.kind == "multipart" %}
	var {{ op.content_type_identifier }} string
{% if body.required %}{% if body.content_encoding %}
	if {{ op.err_identifier }} := {{ op.client_identifier }}.validateStringEncoding({{ op.body_identifier }}, "{{ body.content_encoding }}", "request body", {{ op.request_options_identifier }}); {{ op.err_identifier }} != nil {
		return nil, {{ op.err_identifier }}
	}
{% endif %}
	{{ op.body_reader_identifier }}, {{ op.content_type_identifier }}, {{ op.err_identifier }} = {{ op.client_identifier }}.encodeMultipartBody({{ op.body_identifier }})
	if {{ op.err_identifier }} != nil {
		return nil, {{ op.err_identifier }}
	}
	{{ op.headers_identifier }}.Set("Content-Type", {{ op.content_type_identifier }})
{% else %}
	if {{ op.body_identifier }} != nil {
{% if body.content_encoding %}
		if {{ op.err_identifier }} := {{ op.client_identifier }}.validateStringEncoding({{ op.body_identifier }}, "{{ body.content_encoding }}", "request body", {{ op.request_options_identifier }}); {{ op.err_identifier }} != nil {
			return nil, err
		}
{% endif %}
		{{ op.body_reader_identifier }}, {{ op.content_type_identifier }}, {{ op.err_identifier }} = {{ op.client_identifier }}.encodeMultipartBody({{ op.body_identifier }})
		if {{ op.err_identifier }} != nil {
			return nil, {{ op.err_identifier }}
		}
		{{ op.headers_identifier }}.Set("Content-Type", {{ op.content_type_identifier }})
	}
{% endif %}{% else %}
	{{ op.body_reader_identifier }} = {{ op.body_identifier }}
{% endif %}{% endif %}
	{{ op.headers_identifier }} = {{ op.client_identifier }}.mergeHeaders({{ op.headers_identifier }}, {{ op.request_options_identifier }})
	{{ op.request_identifier }}, {{ op.err_identifier }} := http.NewRequestWithContext({{ op.ctx_identifier }}, {{ op.method | go_method }}, {{ op.client_identifier }}.buildURL({{ op.path_identifier }}, {{ op.query_identifier }}), {{ op.body_reader_identifier }})
	if {{ op.err_identifier }} != nil {
		return nil, {{ op.err_identifier }}
	}
	{{ op.request_identifier }}.Header = {{ op.headers_identifier }}
	for _, {{ op.cookie_identifier }} := range {{ op.cookies_identifier }} {
		{{ op.request_identifier }}.AddCookie({{ op.cookie_identifier }})
	}
	return {{ op.client_identifier }}.httpClient.Do({{ op.request_identifier }})
}

