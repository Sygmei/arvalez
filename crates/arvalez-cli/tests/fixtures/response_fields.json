{
  "openapi": "3.1.0",
  "info": {
    "title": "Response policies",
    "version": "1"
  },
  "paths": {
    "/widgets": {
      "post": {
        "operationId": "createWidget",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Widget"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Widget"
                }
              }
            }
          },
          "400": {
            "description": "response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/input": {
      "post": {
        "operationId": "sendInput",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OnlyRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "empty"
          }
        }
      }
    },
    "/link": {
      "get": {
        "operationId": "getLink",
        "responses": {
          "200": {
            "description": "recursive",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Link"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Widget": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "title": {
            "type": "string",
            "default": "draft"
          },
          "nickname": {
            "type": [
              "string",
              "null"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "quantity": {
            "type": "integer"
          },
          "labels": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "metadata": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "string"
            }
          },
          "blob": {
            "type": [
              "string",
              "null"
            ],
            "format": "binary"
          },
          "state": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/State"
              },
              {
                "type": "null"
              }
            ]
          },
          "child": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Child"
              },
              {
                "type": "null"
              }
            ]
          },
          "partial": {
            "$ref": "#/components/schemas/Partial"
          },
          "choice": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "pair": {
            "type": [
              "array",
              "null"
            ],
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ],
            "items": false,
            "minItems": 2
          }
        }
      },
      "Child": {
        "type": "object",
        "properties": {
          "value": {
            "type": [
              "string",
              "null"
            ]
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Child"
            }
          }
        }
      },
      "Partial": {
        "type": "object",
        "properties": {
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "State": {
        "type": "string",
        "enum": [
          "ready",
          "done"
        ]
      },
      "Problem": {
        "type": "object",
        "properties": {
          "message": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "OnlyRequest": {
        "type": "object",
        "properties": {
          "input": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Link": {
        "type": "object",
        "properties": {
          "next": {
            "$ref": "#/components/schemas/Link"
          }
        }
      }
    }
  }
}
