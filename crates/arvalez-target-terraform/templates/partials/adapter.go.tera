{% if model.object %}
func codec{{ model.name }}() codec[sdk.{{ model.name }}] {
    fields := map[string]fieldSpec{
{% for field in model.fields %}
        "{{ field.attribute }}": {node: {{ field.codec }}.node, description: {{ field.description | safe }}},
{% endfor %}
    }
    typ := objectType(fields)
    return codec[sdk.{{ model.name }}]{
        node: &schemaNode{typ: typ, fields: fields},
        from: func(ctx context.Context, value sdk.{{ model.name }}, p path.Path) (attr.Value, diag.Diagnostics) {
            values := make(map[string]attr.Value, len(fields))
            var diagnostics diag.Diagnostics
{% for field in model.fields %}
            {
                v, d := {{ field.codec }}.from(ctx, value.{{ field.name }}, p.AtName("{{ field.attribute }}"))
                diagnostics.Append(d...)
                values["{{ field.attribute }}"] = v
            }
{% endfor %}
            if diagnostics.HasError() { return nil, diagnostics }
            result, d := types.ObjectValue(typ.AttrTypes, values)
            diagnostics.Append(d...)
            return result, diagnostics
        },
        to: func(ctx context.Context, value attr.Value, p path.Path) (sdk.{{ model.name }}, diag.Diagnostics) {
            var result sdk.{{ model.name }}
            if d := requireKnown(value, typ, p, false); d.HasError() { return result, d }
{% if model.fields | length > 0 %}
            values := value.(types.Object).Attributes()
{% endif %}
            var diagnostics diag.Diagnostics
{% for field in model.fields %}
            {
                v, d := {{ field.codec }}.to(ctx, values["{{ field.attribute }}"], p.AtName("{{ field.attribute }}"))
                diagnostics.Append(d...)
                result.{{ field.name }} = v
            }
{% endfor %}
            if diagnostics.HasError() { return sdk.{{ model.name }}{}, diagnostics }
            return result, diagnostics
        },
    }
}

func {{ model.name }}AttributeTypes() map[string]attr.Type {
    return codec{{ model.name }}().node.typ.(types.ObjectType).AttrTypes
}
{% else %}
func codec{{ model.name }}() codec[sdk.{{ model.name }}] {
    return mappedCodec({{ model.base_codec }},
        func(value sdk.{{ model.name }}) {{ model.base }} { return {{ model.base }}(value) },
        func(value {{ model.base }}) sdk.{{ model.name }} { return sdk.{{ model.name }}(value) })
}
{% endif %}

// {{ model.name }}ValueFromAPI converts an SDK value to a Terraform value without interpreting schema roles.
// A nil input produces a typed null. On error, the result is a typed null with diagnostics.
func {{ model.name }}ValueFromAPI(ctx context.Context, value *sdk.{{ model.name }}) ({{ model.tf_type }}, diag.Diagnostics) {
    c := codec{{ model.name }}()
    converted, diagnostics := pointerCodec(c).from(ctx, value, path.Empty())
    if diagnostics.HasError() { return nullValue(c.node.typ).({{ model.tf_type }}), diagnostics }
    return converted.({{ model.tf_type }}), diagnostics
}

// {{ model.name }}ValueToAPI converts a Terraform value to an SDK value. A typed null produces nil.
// Unknown or unrepresentable values produce diagnostics. Schema roles do not omit fields.
func {{ model.name }}ValueToAPI(ctx context.Context, value {{ model.tf_type }}) (*sdk.{{ model.name }}, diag.Diagnostics) {
    return pointerCodec(codec{{ model.name }}()).to(ctx, value, path.Empty())
}

// {{ model.name }}ModelFromAPI converts an SDK value to a generated model. A nil input produces nil.
func {{ model.name }}ModelFromAPI(ctx context.Context, value *sdk.{{ model.name }}) (*{{ model.name }}Model, diag.Diagnostics) {
    if value == nil { return nil, nil }
    converted, diagnostics := {{ model.name }}ValueFromAPI(ctx, value)
    if diagnostics.HasError() { return nil, diagnostics }
{% if model.object %}
    var result {{ model.name }}Model
    diagnostics.Append(converted.As(ctx, &result, basetypes.ObjectAsOptions{})...)
{% else %}
    result := converted
{% endif %}
    if diagnostics.HasError() { return nil, diagnostics }
    return &result, diagnostics
}

// {{ model.name }}ModelToAPI converts a generated model to an SDK value. A nil input produces nil.
// Unknown or unrepresentable values produce diagnostics. Schema roles do not omit fields.
func {{ model.name }}ModelToAPI(ctx context.Context, value *{{ model.name }}Model) (*sdk.{{ model.name }}, diag.Diagnostics) {
    if value == nil { return nil, nil }
{% if model.object %}
    converted, diagnostics := types.ObjectValueFrom(ctx, {{ model.name }}AttributeTypes(), value)
    if diagnostics.HasError() { return nil, diagnostics }
{% else %}
    converted := *value
    var diagnostics diag.Diagnostics
{% endif %}
    result, d := {{ model.name }}ValueToAPI(ctx, converted)
    diagnostics.Append(d...)
    if diagnostics.HasError() { return nil, diagnostics }
    return result, diagnostics
}
